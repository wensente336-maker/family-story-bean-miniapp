APP_ENV=development
APP_NAME=家庭故事豆 API
API_PREFIX=/v1
DATABASE_URL=postgresql+psycopg://storybean:storybean@127.0.0.1:5432/storybean
REDIS_URL=redis://127.0.0.1:6379/0
OBJECT_STORAGE_BUCKET=family-story-bean-dev
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
PIPELINE_VERSION=storyboard-v1
ALLOW_MOCK_ROUTES=true
ALLOW_DEV_WECHAT_LOGIN=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
AUTH_SIGNING_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=7200
WEB_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
PUBLIC_WEB_BASE_URL=http://127.0.0.1:4173
ALLOW_DEV_WEB_OTP=true
WEB_OTP_DEV_CODE=123456
WEB_OTP_TTL_SECONDS=300
WEB_OTP_RESEND_SECONDS=60
UPLOAD_TOKEN_TTL_SECONDS=900
MAX_AUDIO_BYTES=524288000
LOCAL_OBJECT_STORAGE_PATH=.data/objects
PIPELINE_ACCEPT_NEW_JOBS=true
PIPELINE_DEMO_STEP_SECONDS=1.0
PIPELINE_STALE_AFTER_SECONDS=120
PIPELINE_TASK_TIME_LIMIT_SECONDS=900
ALLOW_TASK_FAULT_INJECTION=false
ASR_PROVIDER=mlx_whisper
ALLOW_DEMO_ASR=false
ASR_MODEL_PATH=
ASR_RETRY_MODEL_PATH=
ASR_LANGUAGE=zh
ASR_LOW_CONFIDENCE_THRESHOLD=0.65
ASR_RETRY_ENABLED=true
ASR_MAX_RETRY_SEGMENTS=8
ASR_INITIAL_PROMPT=请忠实转写为简体中文，保留人物名称、自然标点和完整语义。
PLAYBACK_TOKEN_TTL_SECONDS=600
PODCAST_TTS_PROVIDER=auto
PODCAST_TTS_FALLBACK_TO_SYSTEM=true
PODCAST_SCRIPT_PROVIDER=safe-template
PODCAST_SCRIPT_MODEL=sound-story-safe-v1
PODCAST_SCRIPT_ENDPOINT=
PODCAST_SCRIPT_API_KEY=
PODCAST_SCRIPT_TIMEOUT_SECONDS=45
PODCAST_RENDER_DISPATCHER=local
PODCAST_RENDER_MAX_RETRIES=2
# 发布灰度：open 全量、allowlist 仅 PODCAST_ROLLOUT_USER_IDS、off 紧急关闭新增。
PODCAST_CREATION_ENABLED=true
PODCAST_SHARING_ENABLED=true
PODCAST_ROLLOUT_MODE=open
PODCAST_ROLLOUT_USER_IDS=
# 新版 MVP 默认关闭漫画/绘本新增与重画；设为 true 可回滚到旧入口。
COMIC_CREATION_ENABLED=false
# 凭证只能放在服务端 .env，不要以 VITE_ 开头，也不要提交到仓库。
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_TOKEN=
# 新版控制台如果只提供 API Key，填这一项即可。
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_VOICE=zh_female_xiaohe_uranus_bigtts
VOLCENGINE_TTS_SAMPLE_RATE=24000
VOLCENGINE_TTS_SPEECH_RATE=-8
VOLCENGINE_TTS_TIMEOUT_SECONDS=45
