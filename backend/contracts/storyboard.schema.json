{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-story-bean.local/schemas/storyboard-v1.json",
  "title": "Family Story Bean Storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "title",
    "scene",
    "story_type",
    "characters",
    "setup",
    "turning_point",
    "ending",
    "emotion_curve",
    "source_segments",
    "sensitive_flags",
    "confidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "pipeline_version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "scene": {"type": "string", "minLength": 1, "maxLength": 200},
    "story_type": {"type": "string", "minLength": 1, "maxLength": 40},
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family_member_id", "speaker_key", "display_name"],
        "properties": {
          "family_member_id": {"type": ["string", "null"], "format": "uuid"},
          "speaker_key": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1}
        }
      }
    },
    "setup": {"type": "string", "minLength": 1},
    "turning_point": {"type": "string", "minLength": 1},
    "ending": {"type": "string", "minLength": 1},
    "highlight_quote": {"type": ["string", "null"]},
    "emotion_curve": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "source_segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transcript_segment_id", "start_ms", "end_ms", "quote"],
        "properties": {
          "transcript_segment_id": {"type": "string", "format": "uuid"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "exclusiveMinimum": 0},
          "quote": {"type": ["string", "null"]}
        }
      }
    },
    "sensitive_flags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
