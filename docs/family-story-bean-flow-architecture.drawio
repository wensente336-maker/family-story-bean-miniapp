        <mxCell id="transcript-items" value="&lt;b&gt;音轨提取与格式统一&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;本地 Whisper 转写&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;时间戳与说话人 A/B/C&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8FCF9;strokeColor=#E1EDE5;spacing=8;fontFamily=PingFang SC;fontSize=16;fontColor=#3C504A;" vertex="1" parent="1"><mxGeometry x="474" y="308" width="242" height="185" as="geometry"/></mxCell>
