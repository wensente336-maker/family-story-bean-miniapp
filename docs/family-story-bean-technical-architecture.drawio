        </mxCell>
        <mxCell id="id-family" value="&lt;b&gt;家庭空间 family_id&lt;/b&gt;&lt;br&gt;所有查询先校验当前用户是否属于该家庭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2ECFA;strokeColor=#8969B0;fontColor=#4D3768;" vertex="1" parent="identity-group">
          <mxGeometry x="50" y="60" width="290" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="id-recording" value="&lt;b&gt;录音 recording_id&lt;/b&gt;&lt;br&gt;原始文件、逐字稿、高光都绑定同一录音" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4E81B5;fontColor=#244E78;" vertex="1" parent="identity-group">
          <mxGeometry x="405" y="60" width="290" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="id-segment" value="&lt;b&gt;片段 transcript_segment_id&lt;/b&gt;&lt;br&gt;人物原话永远保留毫秒级来源时间戳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4E81B5;fontColor=#244E78;" vertex="1" parent="identity-group">
          <mxGeometry x="760" y="60" width="290" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="id-material" value="&lt;b&gt;素材版本 material_set_id&lt;/b&gt;&lt;br&gt;用户确认后冻结；修改会新增版本，不覆盖旧事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EC;strokeColor=#E56F51;fontColor=#783321;" vertex="1" parent="identity-group">
          <mxGeometry x="740" y="180" width="310" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="id-version" value="&lt;b&gt;作品版本 podcast_version_id&lt;/b&gt;&lt;br&gt;每次重混音生成独立版本；封面和标签是作品元数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EC;strokeColor=#E56F51;fontColor=#783321;" vertex="1" parent="identity-group">
          <mxGeometry x="355" y="180" width="330" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="ie1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#687578;endArrow=classic;" edge="1" source="id-family" target="id-recording" parent="identity-group"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ie2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#687578;endArrow=classic;" edge="1" source="id-recording" target="id-segment" parent="identity-group"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ie3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D76549;endArrow=classic;" edge="1" source="id-segment" target="id-material" parent="identity-group"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ie4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D76549;endArrow=classic;" edge="1" source="id-material" target="id-version" parent="identity-group"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rules" value="&lt;b&gt;三条硬规则&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. AI 只读取已确认的声音事实版本&lt;br&gt;2. 直接引语必须绑定 source_segment_id 与时间戳&lt;br&gt;3. 修改生成新版本，历史逐字稿与成品永不被静默覆盖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#687578;fontColor=#354547;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1200" y="705" width="580" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="model-note" value="&lt;b&gt;模型与服务边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;ASR：本地 MLX Whisper&lt;br&gt;脚本：当前 safe-template，预留服务端 LLM Endpoint&lt;br&gt;解说：火山引擎 Seed-TTS 2.0，系统音色降级&lt;br&gt;混音：本地 FFmpeg&lt;br&gt;&lt;br&gt;模型密钥只存后端环境变量，前端不可见。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#687578;fontColor=#354547;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1200" y="920" width="580" height="220" as="geometry"/>
        </mxCell>
      </root>
