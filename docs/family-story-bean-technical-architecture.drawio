        <mxCell id="identity-group" value="防止内容“串掉”的数据隔离与版本规则" style="swimlane;startSize=34;rounded=1;container=1;pointerEvents=0;fillColor=#F4F6F6;strokeColor=#687578;fontColor=#354547;fontStyle=1;fontSize=15;html=1;" vertex="1" parent="1">
