page { background: #f7f1e8; color: #2f2924; min-height: 100%; }
.page { padding: 44rpx 32rpx 80rpx; }
.hero { display: flex; flex-direction: column; margin-bottom: 32rpx; }
.eyebrow { color: #a26c3d; font-size: 20rpx; letter-spacing: 4rpx; font-weight: 700; }
.title { font-size: 52rpx; line-height: 1.2; font-weight: 800; margin: 12rpx 0; }
.intro { color: #766d64; font-size: 27rpx; }
.card { background: #fffdf8; border-radius: 30rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 12rpx 36rpx rgba(77, 58, 41, .07); }
.label, .section-title { display: block; font-size: 27rpx; font-weight: 700; margin: 8rpx 0 14rpx; }
.section-title { font-size: 32rpx; margin-bottom: 22rpx; }
.input { height: 88rpx; background: #f4ede3; border-radius: 20rpx; padding: 0 24rpx; margin-bottom: 28rpx; box-sizing: border-box; }
.primary { background: #e56f45; color: white; border-radius: 999rpx; font-weight: 700; margin-top: 10rpx; }
.primary::after, .add::after { border: 0; }
.error { display: block; color: #bd4b36; text-align: center; margin-top: 18rpx; font-size: 24rpx; }
.member { display: flex; align-items: center; gap: 18rpx; padding: 14rpx 0; }
.avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #f4c86a; display: flex; align-items: center; justify-content: center; font-weight: 800; }
.add-row { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; }
.compact { flex: 1; margin: 0; }
.add { width: 140rpx; background: #2f6c63; color: white; border-radius: 20rpx; font-size: 26rpx; }
