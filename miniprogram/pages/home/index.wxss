.page-shell {
  padding: 30rpx 28rpx 0;
  overflow: hidden;
}

.topbar, .brand-row, .processing-title-row, .section-heading, .moment-meta, .moment-footer, .timeline-card {
  display: flex;
  align-items: center;
}

.topbar {
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.eyebrow, .section-kicker, .timeline-kicker {
  display: block;
  color: #8a7969;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 7rpx;
}

.brand-row { gap: 12rpx; }

.brand {
  color: #173b3f;
  font-size: 39rpx;
  font-weight: 760;
  letter-spacing: -1rpx;
}

.bean-mark {
  width: 29rpx;
  height: 35rpx;
  border-radius: 50% 48% 52% 48%;
  background: #ff795c;
  transform: rotate(26deg);
  position: relative;
}

.bean-dot {
  position: absolute;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #fff4df;
  left: 8rpx;
  top: 8rpx;
}

.avatar-stack { display: flex; padding-right: 8rpx; }

.avatar {
  width: 54rpx;
  height: 54rpx;
  margin-right: -12rpx;
  border: 4rpx solid #f7f1e8;
  border-radius: 50%;
  color: #173b3f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
}

.avatar-one { background: #f3c66c; }
.avatar-two { background: #f5a08c; }
.avatar-three { background: #b9ded0; }

.hero-card {
  min-height: 560rpx;
  padding: 42rpx 34rpx 34rpx;
  box-sizing: border-box;
  border-radius: 44rpx;
  background: #173b3f;
  color: #fff8ee;
  position: relative;
  overflow: hidden;
}

.hero-copy { position: relative; z-index: 3; width: 68%; }

.privacy-pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #dce9e2;
  font-size: 21rpx;
}

.privacy-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #9ee2ba;
  box-shadow: 0 0 0 7rpx rgba(158, 226, 186, 0.12);
}

.hero-title {
  display: block;
  margin-top: 28rpx;
  font-size: 52rpx;
  line-height: 1.22;
  font-weight: 760;
  letter-spacing: -2rpx;
}

.hero-subtitle {
  display: block;
  margin-top: 22rpx;
  color: #c4d6d2;
  font-size: 25rpx;
  line-height: 1.7;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 318rpx;
  height: 88rpx;
  margin-top: 30rpx;
  background: #ff7a5c;
  color: white;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 34rpx rgba(255, 122, 92, 0.25);
}

.upload-icon {
  width: 38rpx;
  height: 38rpx;
  margin-right: 13rpx;
  border: 2rpx solid rgba(255,255,255,.65);
  border-radius: 50%;
  position: relative;
}

.upload-arrow:before, .upload-arrow:after {
  content: "";
  position: absolute;
  background: white;
}

.upload-arrow:before { width: 3rpx; height: 17rpx; left: 17rpx; top: 10rpx; }
.upload-arrow:after { width: 10rpx; height: 10rpx; border-left: 3rpx solid white; border-top: 3rpx solid white; background: transparent; left: 12rpx; top: 9rpx; transform: rotate(45deg); }

.hero-hint {
  display: block;
  margin-top: 16rpx;
  color: #87aaa7;
  font-size: 19rpx;
  text-align: center;
  width: 318rpx;
}

.hero-glow { position: absolute; border-radius: 50%; filter: blur(2rpx); }
.hero-glow-one { width: 390rpx; height: 390rpx; right: -170rpx; bottom: -120rpx; background: rgba(104, 181, 160, .18); }
.hero-glow-two { width: 220rpx; height: 220rpx; right: 60rpx; top: -100rpx; background: rgba(246, 198, 108, .11); }

.wave-stage { position: absolute; width: 300rpx; height: 300rpx; right: -26rpx; bottom: 12rpx; }
.recording-bean {
  position: absolute;
  width: 106rpx;
  height: 132rpx;
  left: 92rpx;
  top: 83rpx;
  border-radius: 48% 50% 47% 53%;
  background: linear-gradient(145deg, #ff987f, #ff684d);
  transform: rotate(20deg);
  box-shadow: inset 12rpx 10rpx 22rpx rgba(255,255,255,.18), 0 22rpx 44rpx rgba(0,0,0,.22);
  z-index: 2;
}
.bean-hole { position: absolute; width: 24rpx; height: 24rpx; border: 7rpx solid #173b3f; border-radius: 50%; right: 15rpx; top: 12rpx; opacity: .72; }
.bean-light { position: absolute; width: 11rpx; height: 11rpx; border-radius: 50%; background: #fff2a9; left: 28rpx; bottom: 20rpx; box-shadow: 0 0 16rpx #fff2a9; }
.wave { position: absolute; border: 2rpx solid rgba(181, 235, 216, .22); border-radius: 50%; left: 50%; top: 50%; transform: translate(-50%, -50%); }
.wave-one { width: 176rpx; height: 176rpx; }
.wave-two { width: 238rpx; height: 238rpx; }
.wave-three { width: 294rpx; height: 294rpx; }
.spark { position: absolute; width: 9rpx; height: 9rpx; border-radius: 50%; background: #f6ca70; }
.spark-one { right: 43rpx; top: 48rpx; }
.spark-two { left: 37rpx; bottom: 48rpx; background: #9ee2ba; }

.processing-card {
  display: flex;
  align-items: center;
  margin: 22rpx 2rpx 0;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fffaf2;
  box-shadow: 0 12rpx 42rpx rgba(68, 55, 43, .07);
}
.processing-icon { width: 78rpx; height: 78rpx; border-radius: 23rpx; background: #dcece3; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.mini-wave { display: flex; align-items: center; gap: 5rpx; height: 38rpx; }
.mini-wave view { display: block; width: 5rpx; border-radius: 6rpx; background: #33716f; }
.mini-wave view:nth-child(1) { height: 15rpx; }.mini-wave view:nth-child(2) { height: 32rpx; }.mini-wave view:nth-child(3) { height: 22rpx; }.mini-wave view:nth-child(4) { height: 29rpx; }
.processing-copy { margin-left: 20rpx; flex: 1; }
.processing-title-row { justify-content: space-between; }
.processing-title { font-size: 27rpx; font-weight: 700; }
.processing-percent { font-size: 22rpx; color: #ec755a; font-weight: 700; }
.processing-detail { display: block; margin-top: 5rpx; font-size: 21rpx; color: #8d8277; }
.progress-track { height: 8rpx; margin-top: 16rpx; border-radius: 999rpx; overflow: hidden; background: #eee7dc; }
.progress-value { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #ffad73, #ff755a); }

.section-heading { justify-content: space-between; margin: 48rpx 4rpx 22rpx; }
.section-kicker { color: #d16e57; margin-bottom: 4rpx; }
.section-title { display: block; font-size: 36rpx; font-weight: 750; letter-spacing: -1rpx; }
.section-action { color: #6f8f8d; font-size: 23rpx; }

.moment-scroll { width: calc(100% + 28rpx); overflow: visible; }
.moment-row { display: flex; gap: 20rpx; width: max-content; padding-right: 30rpx; }
.moment-card { width: 510rpx; min-height: 496rpx; padding: 25rpx; border-radius: 34rpx; box-sizing: border-box; }
.moment-card.sun { background: #f6d98f; }
.moment-card.coral { background: #f3b0a0; }
.moment-meta { justify-content: space-between; }
.moment-theme { padding: 8rpx 14rpx; background: rgba(255,255,255,.55); border-radius: 999rpx; font-size: 20rpx; font-weight: 700; }
.moment-duration { font-size: 21rpx; color: rgba(23,59,63,.65); }
.story-art { height: 190rpx; position: relative; overflow: hidden; margin: 18rpx 0 20rpx; border-radius: 24rpx; background: rgba(255,250,239,.42); }
.story-sun { position: absolute; width: 52rpx; height: 52rpx; border-radius: 50%; background: #fff4bc; right: 36rpx; top: 24rpx; box-shadow: 0 0 0 12rpx rgba(255,244,188,.22); }
.story-table { position: absolute; width: 310rpx; height: 38rpx; border-radius: 50%; background: #d78660; left: 72rpx; bottom: 8rpx; }
.story-person { position: absolute; bottom: 32rpx; z-index: 2; }
.person-left { left: 110rpx; }.person-right { right: 105rpx; transform: scale(.88); }
.person-head { width: 55rpx; height: 55rpx; border-radius: 50%; background: #f6bd8f; border: 9rpx solid #2e6666; box-sizing: border-box; }
.person-body { width: 75rpx; height: 78rpx; border-radius: 38rpx 38rpx 12rpx 12rpx; margin-left: -10rpx; background: #fff3dc; }
.person-right .person-head { border-color: #dc6f58; }.person-right .person-body { background: #6ca69c; }
.moment-title { display: block; font-size: 33rpx; font-weight: 750; }
.moment-quote { display: block; min-height: 65rpx; margin-top: 10rpx; color: rgba(23,59,63,.72); font-size: 23rpx; line-height: 1.5; }
.moment-footer { margin-top: 18rpx; font-size: 22rpx; font-weight: 650; }
.play-button { width: 43rpx; height: 43rpx; margin-right: 12rpx; border-radius: 50%; background: #173b3f; color: white; display: flex; justify-content: center; align-items: center; font-size: 16rpx; padding-left: 3rpx; }
.arrow { margin-left: auto; font-size: 30rpx; }

.creation-heading { margin-top: 54rpx; }
.creation-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.creation-card { min-height: 334rpx; padding: 26rpx; border-radius: 32rpx; box-sizing: border-box; }
.comic-card { background: #e1ede5; }.podcast-card { background: #eee0da; }
.creation-icon { height: 120rpx; margin-bottom: 22rpx; position: relative; }
.comic-frame { position: absolute; width: 74rpx; height: 84rpx; border: 5rpx solid #34706d; border-radius: 13rpx; background: #fff9e9; }
.frame-a { left: 30rpx; top: 17rpx; transform: rotate(-8deg); }.frame-b { left: 102rpx; top: 8rpx; transform: rotate(8deg); background: #f4c66e; }
.comic-bubble { position: absolute; width: 38rpx; height: 28rpx; border-radius: 50%; background: #ff7a5c; left: 130rpx; top: 27rpx; }
.podcast-circle { position: absolute; width: 93rpx; height: 93rpx; left: 75rpx; top: 10rpx; border: 11rpx solid #d06e5a; border-radius: 50%; box-sizing: border-box; }
.podcast-line { position: absolute; width: 7rpx; border-radius: 8rpx; background: #173b3f; bottom: 14rpx; }
.line-a { height: 35rpx; left: 43rpx; }.line-b { height: 66rpx; left: 57rpx; }.line-c { height: 46rpx; left: 71rpx; }
.creation-title { display: block; font-size: 30rpx; font-weight: 750; }
.creation-subtitle { display: block; margin-top: 8rpx; min-height: 62rpx; color: #7f776d; font-size: 21rpx; line-height: 1.5; }
.creation-link { display: block; margin-top: 16rpx; color: #d66f58; font-size: 22rpx; font-weight: 700; }

.timeline-card { margin-top: 22rpx; padding: 24rpx; border-radius: 30rpx; background: #fffaf2; }
.timeline-date { width: 73rpx; height: 80rpx; border-radius: 20rpx; background: #173b3f; color: white; text-align: center; display: flex; flex-direction: column; justify-content: center; }
.timeline-month { font-size: 15rpx; letter-spacing: 2rpx; color: #9ac9bd; }.timeline-day { font-size: 28rpx; font-weight: 750; }
.timeline-copy { margin-left: 20rpx; flex: 1; }
.timeline-kicker { margin: 0 0 4rpx; font-size: 19rpx; color: #d16e57; }
.timeline-title { display: block; font-size: 24rpx; font-weight: 650; }
.timeline-arrow { font-size: 42rpx; color: #8fa4a0; }

.safe-space { height: 160rpx; }
.tabbar { position: fixed; left: 24rpx; right: 24rpx; bottom: 24rpx; height: 104rpx; z-index: 20; display: flex; justify-content: space-around; align-items: center; border-radius: 35rpx; background: rgba(255,250,242,.96); box-shadow: 0 16rpx 55rpx rgba(58,48,39,.16); }
.tab { min-width: 120rpx; color: #9b9289; font-size: 19rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.tab.active { color: #173b3f; font-weight: 700; }
.tab-home, .tab-timeline, .tab-family { width: 28rpx; height: 28rpx; position: relative; }
.tab-home { border-radius: 7rpx; background: #173b3f; transform: rotate(45deg) scale(.75); }
.tab-timeline { border: 4rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }.tab-timeline:after { content: ""; position: absolute; width: 3rpx; height: 9rpx; background: currentColor; left: 9rpx; top: 4rpx; }
.tab-family:before, .tab-family:after { content: ""; position: absolute; border-radius: 50%; background: currentColor; }.tab-family:before { width: 13rpx; height: 13rpx; left: 7rpx; top: 0; }.tab-family:after { width: 27rpx; height: 13rpx; left: 0; bottom: 0; border-radius: 14rpx 14rpx 5rpx 5rpx; }
