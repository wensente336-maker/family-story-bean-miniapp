page { background: #f7f1e8; color: #2f2924; }
.page { min-height: 80vh; padding: 80rpx 52rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.bean { width: 104rpx; height: 104rpx; border-radius: 48% 52% 56% 44%; background: #efb24c; color: #fff4dc; display: flex; align-items: center; justify-content: center; font-size: 34rpx; transform: rotate(-12deg); }
.title { font-size: 42rpx; font-weight: 800; margin: 32rpx 0 14rpx; }
.detail { color: #786e65; line-height: 1.7; margin-bottom: 38rpx; }
button { width: 320rpx; border-radius: 999rpx; background: #2f6c63; color: white; }
button::after { border: 0; }
